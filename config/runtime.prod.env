# Production profile — champion-only path gated by production_manifest.yaml
# Use: MLCOUNCIL_ENV_PROFILE=prod
#
# Promote challengers only after walk-forward gate:
#   python scripts/run_walkforward_promotion.py --model lightgbm
#   python scripts/promote_model.py --model lightgbm
#
# Experimental "all flags on" remains: MLCOUNCIL_ENV_PROFILE=frontier

MLCOUNCIL_USE_PRODUCTION_MANIFEST=true
MLCOUNCIL_AUTO_PROMOTE_MODELS=false

# Safe production defaults (manifest may enable subsets after promotion)
MLCOUNCIL_AUTO_EXECUTE=false
MLCOUNCIL_AUTOMATION_PAUSED=false

# Observability recommended in prod but off until you enable in manifest.features
# MLCOUNCIL_OTEL_ENABLED=false
