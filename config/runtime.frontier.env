# MLCouncil — Frontier profile (all disruptive tracks ON)
# Use: MLCOUNCIL_ENV_PROFILE=frontier  (auto-loads this file via runtime_env.py)
#
# Requires one-time checkpoint bootstrap:
#   python scripts/bootstrap_frontier.py
#
# Observability stack (optional but recommended):
#   docker compose -f docker-compose.observability.yml up -d

# --- Wave 1 ---
MLCOUNCIL_ONLINE_LEARNING=true
MLCOUNCIL_OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SERVICE_NAME=mlcouncil-dagster
MLCOUNCIL_OTEL_NAMESPACE=mlcouncil

# --- Wave 2 (challengers active in council / shadow) ---
MLCOUNCIL_REGIME_MODE=embedding
MLCOUNCIL_REGIME_DSS_SHADOW=false
MLCOUNCIL_LLM_SENTIMENT_SHADOW=true
MLCOUNCIL_LLM_SENTIMENT_MOCK=true
MLCOUNCIL_TFT_IN_COUNCIL=true
MLCOUNCIL_MICROSTRUCTURE_PROMOTED=true
MLCOUNCIL_MICROSTRUCTURE_SHADOW=false
MLCOUNCIL_ORDERBOOK_FEED=synthetic

# --- Wave 3 ---
MLCOUNCIL_AGGREGATOR_MODE=moe
MLCOUNCIL_POSITION_SIZING=cqr
MLCOUNCIL_STACKING_SHADOW=true
MLCOUNCIL_USE_STACKED_COUNCIL=true
MLCOUNCIL_STACKING_BACKEND=ridge
MLCOUNCIL_COVARIANCE_ESTIMATOR=dcc
MLCOUNCIL_PORTFOLIO_MODE=diff

# --- Portfolio extras ---
MLCOUNCIL_HRP_SOFT_PRIOR=true
MLCOUNCIL_HRP_BLEND=0.25

# --- Trading (same guardrails as paper) ---
MLCOUNCIL_AUTO_EXECUTE=false
MLCOUNCIL_AUTOMATION_PAUSED=false
