# =============================================================================
# MLCouncil — Environment variables template
# =============================================================================
# Copy to `.env` in the repo root (never commit `.env` with real secrets).
#
# Load order (see `runtime_env.py` → `load_runtime_env()`):
#   1. Docker secrets in /run/secrets/ (if present)
#   2. `.env` (project root — this file)
#   3. `config/runtime.env` or `config/runtime.<profile>.env` (profile-aware)
#   4. `config/runtime_override.env` (optional final overlay)
#   5. Process environment (overrides everything above)
#
# Profile selection (MLCOUNCIL_ENV_PROFILE):
#   local    — No validation, no trading (default when unset)
#   paper    — Requires ALPACA_*, validates against paper endpoint
#   prod     — Same validation as paper; uses production_manifest.yaml for gate
#   frontier — All disruptive tracks ON, bypasses promotion gate (R&D only)
#
# Legacy alias note:
#   ALPACA_PAPER_KEY  → auto-mapped to ALPACA_API_KEY
#   ALPACA_PAPER_SECRET → auto-mapped to ALPACA_SECRET_KEY
#   If both are set, ALPACA_PAPER_* wins. Set only the canonical names.
#
# Placeholder detection:
#   Values matching "replace-me", "changeme", "your-*", or empty string are
#   treated as unset. Profile validation fails if required keys are placeholders.
#
# Production daily pipeline (as of production_manifest.yaml):
#   champion: TFT (technical), FinBERT (sentiment), HMM (regime),
#   conformal sizing, DCC covariance, CVXPY portfolio.
# =============================================================================


# -----------------------------------------------------------------------------
# Container ports (docker-compose.yml)
# -----------------------------------------------------------------------------
ADMIN_API_PORT=8000
DAGSTER_PORT=3000
DASHBOARD_PORT=8501
MLFLOW_PORT=5000


# -----------------------------------------------------------------------------
# Profile & config paths
# -----------------------------------------------------------------------------
# local | paper | prod | frontier
MLCOUNCIL_ENV_PROFILE=prod
MLCOUNCIL_USE_PRODUCTION_MANIFEST=true
MLCOUNCIL_AUTO_PROMOTE_MODELS=false

# Optional: override which dotenv file to load (default: <repo>/.env)
# MLCOUNCIL_DOTENV_PATH=

# Optional: overlay file merged after .env (see config/runtime.env)
# MLCOUNCIL_RUNTIME_ENV_PATH=config/runtime.env

# Require X-API-Key on admin FastAPI (auto true when MLCOUNCIL_ENV_PROFILE=paper)
# MLCOUNCIL_REQUIRE_API_KEY=true
MLCOUNCIL_API_KEY=change-me-long-random-string

# CORS origins for admin API (comma-separated)
MLCOUNCIL_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000


# -----------------------------------------------------------------------------
# Alpaca — paper trading (canonical names)
# -----------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_CRYPTO_URL=https://paper-api.alpaca.markets

# Legacy aliases (auto-mapped from canonical names above — only set these
# if you have a reason to keep them different; normally leave commented out)
# ALPACA_PAPER_KEY=
# ALPACA_PAPER_SECRET=

# Live trading (only if TRADING_MODE=live)
# TRADING_MODE=paper
# ALPACA_LIVE_KEY=
# ALPACA_LIVE_SECRET=

# OMS adapter max notional per position (USD)
# MAX_POSITION_SIZE=50000


# -----------------------------------------------------------------------------
# Market data & ingest APIs
# -----------------------------------------------------------------------------
POLYGON_API_KEY=your_polygon_key
# OPENAI_API_KEY=                          # only for intraday LLM agent (optional)
# MLCOUNCIL_OPENAI_INTRADAY_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# Storage, database, experiment tracking
# -----------------------------------------------------------------------------
ARCTICDB_URI=lmdb://data/arctic/
MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow uses SQLite locally; no PostgreSQL required.
# The variable below is reserved for a future PostgreSQL migration:
# DATABASE_URL=postgresql://mlcouncil:***@localhost:5432/mlcouncil


# -----------------------------------------------------------------------------
# Email alerts (council/alerts.py → council/monitor.py)
# -----------------------------------------------------------------------------
ALERT_EMAIL=you@example.com
SMTP_PASSWORD=your_smtp_app_password


# -----------------------------------------------------------------------------
# Trading automation & safety limits
# -----------------------------------------------------------------------------
# Auto-submit orders after Dagster daily job (admin automation service)
MLCOUNCIL_AUTO_EXECUTE=false
MLCOUNCIL_AUTO_EXECUTE_POLL_SECONDS=5

# Kill switch for automated trading (true = pause)
MLCOUNCIL_AUTOMATION_PAUSED=false

MLCOUNCIL_MAX_DAILY_ORDERS=20
MLCOUNCIL_MAX_TURNOVER=0.30
MLCOUNCIL_MAX_POSITION_SIZE=0.10
MLCOUNCIL_MAX_SECTOR_EXPOSURE=0.25

# Portfolio optimizer / signal filters
MLCOUNCIL_COMMISSION_BPS=0.0
MLCOUNCIL_SLIPPAGE_BPS=3.0
# MLCOUNCIL_MIN_SIGNAL_STRENGTH=0.20
# MLCOUNCIL_MAX_DRAWDOWN_PCT=0.07
# MLCOUNCIL_REBALANCE_EVERY=5

# Self-calibrating transaction costs (nightly artifact)
# MLCOUNCIL_COST_CALIBRATION_PATH=data/operations/cost_calibration.json
# MLCOUNCIL_COST_CALIBRATION_CONFIDENCE_FLOOR=30

# HRP soft prior in portfolio optimizer (optional)
# MLCOUNCIL_HRP_SOFT_PRIOR=false
# MLCOUNCIL_HRP_BLEND=0.25


# -----------------------------------------------------------------------------
# Crypto & intraday (optional)
# -----------------------------------------------------------------------------
MLCOUNCIL_CRYPTO_ENABLED=false
MLCOUNCIL_MAX_CRYPTO_POSITION_SIZE=0.20
MLCOUNCIL_MAX_CRYPTO_TURNOVER=0.40

# Comma-separated tickers for intraday supervisor
# MLCOUNCIL_INTRADAY_UNIVERSE=BTCUSD,ETHUSD,AAPL,MSFT,NVDA
# MLCOUNCIL_INTRADAY_INTERVAL_MINUTES=15
# MLCOUNCIL_INTRADAY_AGENT_PROVIDER=rule-based
# MLCOUNCIL_INTRADAY_LOG_TO_MLFLOW=false
# MLCOUNCIL_INTRADAY_MIN_VALID_CLOSE_RATIO=0.70
# MLCOUNCIL_INTRADAY_MIN_INFORMATIVE_RATIO=0.50


# -----------------------------------------------------------------------------
# Dagster admin client (trigger/monitor pipeline from FastAPI)
# -----------------------------------------------------------------------------
DAGSTER_GRAPHQL_URL=http://localhost:3000/graphql
# DAGSTER_REPOSITORY_NAME=__repository__
# DAGSTER_REPOSITORY_LOCATION_NAME=pipeline.py
# DAGSTER_PARTITION_SET_NAME=daily_pipeline_partition_set


# -----------------------------------------------------------------------------
# Wave 1 — Foundations (off by default; enable in staging first)
# -----------------------------------------------------------------------------

# T1.2 — Incremental LightGBM refit
MLCOUNCIL_ONLINE_LEARNING=false
# MLCOUNCIL_ONLINE_IC_THRESHOLD=0.05
# MLCOUNCIL_ONLINE_REFIT_DAYS=60
# MLCOUNCIL_ONLINE_EVAL_DAYS=10

# T1.4 — OpenTelemetry tracing (observability stack on mlcouncil-net)
MLCOUNCIL_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
#   Docker: OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# MLCOUNCIL_OTEL_NAMESPACE=mlcouncil
# MLCOUNCIL_OTEL_SERVICE_NAME=mlcouncil
# OTEL_DEPLOYMENT_ENVIRONMENT=production

# Per-service OTEL names (set by docker-compose.yml, override for host processes)
# OTEL_SERVICE_NAME_ADMIN=mlcouncil-admin-api
# OTEL_SERVICE_NAME_DAGSTER=mlcouncil-dagster
# OTEL_SERVICE_NAME_INTRADAY=mlcouncil-intraday

# Grafana stack (docker-compose.observability.yml only)
# GRAFANA_PORT=3001
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin


# -----------------------------------------------------------------------------
# Wave 2 — Alpha challengers (shadow only; not daily production path)
# -----------------------------------------------------------------------------

# T2.1 TFT — promoted as champion (production_manifest.yaml); train with:
#   python scripts/train_tft.py

# T2.2 FinMA / RAG sentiment shadow
# MLCOUNCIL_LLM_SENTIMENT_SHADOW=false
# MLCOUNCIL_LLM_SENTIMENT_MOCK=true
# MLCOUNCIL_TFT_IN_COUNCIL=false
# MLCOUNCIL_LLM_GGUF_PATH=
# SEC_EDGAR_USER_AGENT=YourOrg contact@example.com

# T2.3 Deep regime (prod uses 'label' until promoted in manifest)
# MLCOUNCIL_REGIME_MODE=label
# MLCOUNCIL_REGIME_DSS_SHADOW=false

# T2.4 Microstructure / OFI
# MLCOUNCIL_MICROSTRUCTURE_PROMOTED=false
# MLCOUNCIL_MICROSTRUCTURE_SHADOW=true
# MLCOUNCIL_ORDERBOOK_FEED=synthetic


# -----------------------------------------------------------------------------
# Wave 3 — Council & portfolio experiments (off by default)
# -----------------------------------------------------------------------------
# Train checkpoints before enabling:
#   python scripts/train_moe_gating.py
#   python scripts/train_stacking_cqr.py --cqr --stacking

# T3.x — Council / portfolio (prod: set via production_manifest.yaml after gate)
# MLCOUNCIL_AGGREGATOR_MODE=linear
# MLCOUNCIL_POSITION_SIZING=conformal
# MLCOUNCIL_COVARIANCE_ESTIMATOR=dcc
# MLCOUNCIL_PORTFOLIO_MODE=cvxpy
# MLCOUNCIL_STACKING_SHADOW=false
# MLCOUNCIL_USE_STACKED_COUNCIL=false
# MLCOUNCIL_STACKING_BACKEND=ridge


# -----------------------------------------------------------------------------
# Wave 4 — Execution & risk (shadow scaffolds)
# -----------------------------------------------------------------------------
# MLCOUNCIL_RL_EXECUTION_ENABLED=false
# MLCOUNCIL_SMART_ROUTING_ENABLED=false
# MLCOUNCIL_GENERATIVE_STRESS=false
# MLCOUNCIL_CAUSAL_DRIFT_ENABLED=false
# MLCOUNCIL_TDA_WARNING_ENABLED=true

# Walk-forward / promotion ops
# python scripts/populate_walkforward_caches.py
# python scripts/establish_wave2_staging_promotion.py --model tft
# python scripts/promote_council_module.py --module dcc


# -----------------------------------------------------------------------------
# Security & development
# -----------------------------------------------------------------------------
# Allow loading pickle checkpoints without .hash sidecar (dev only)
# MLCOUNCIL_ALLOW_UNHASHED_PICKLE=false
