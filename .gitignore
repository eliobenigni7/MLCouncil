# Environment
.env
.env.*
!.env.example

# Secrets
secrets/

# Data — solo artefatti runtime ignorati; i sorgenti .py sotto data/ restano tracciabili
data/**
!data/**/
!data/**/*.py

# MLflow
mlruns/
mlflow.db

# Python
__pycache__/
*.pyc
*.pyo
*.pkl
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Build
dist/

# Checkpoints
models/checkpoints/

# Generated decisions
data/intraday/decisions/*/
data/intraday/supervisor_state.json

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes (if bind-mounted)
volumes/

# Worktrees
.worktrees/

# Agent / AI tooling (local settings only; repo guidance files stay tracked)
.claude/
.cursor/
.agents/
.mcp.json

# Playwright / browser automation artifacts
.playwright-cli/

# Streamlit (app config.toml stays tracked; local caches ignored)
.streamlit/*
!.streamlit/config.toml

# Test / coverage
.mypy_cache/
.hypothesis/
.coverage
htmlcov/
coverage.xml

# Logs
*.log
